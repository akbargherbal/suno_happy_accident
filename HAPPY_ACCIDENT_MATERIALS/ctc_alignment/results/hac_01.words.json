  "lines": [
    {
      "i": 0,
      "text": "آذَنَتْنَا بِبَيْنِهَا أَسمَاءُ"
    },
    {
      "i": 1,
      "text": "رُبَّ ثَاوٍ يُمَلُّ مِنْهُ الثَّواءُ"
    },
    {
      "i": 2,
      "text": "آذَنَتْنَا بِبَيْنِهَا أَسمَاءُ"
    },
    {
      "i": 3,
      "text": "رُبَّ ثَاوٍ يُمَلُّ مِنْهُ الثَّواءُ"
    },
    {
      "i": 4,
      "text": "آذَنَتْنَا بِبَيْنِهَا ثُمَّ وَلَّتْ"
    },
    {
      "i": 5,
      "text": "لَيْتَ شِعْرِي مَتَى يَكُونُ ٱلِّقَاءُ"
    },
    {
      "i": 6,
      "text": "بَعْدَ عَهْدٍ لَنَا بِبُرْقَةِ شَمَّاءَ"
    },
    {
      "i": 7,
      "text": "فَأَدْنَى دِيَارِهَا الْخَلْصَاءُ"
    },
    {
      "i": 8,
      "text": "فَالْمُحَيَّاةُ فَالصِّفَاحُ فَأَعْنَاقُ فِتَاقٍ فَعَاذِبٌ فَالْوَفاءُ"
    },
    {
      "i": 9,
      "text": "فَرِيَاضُ الْقَطَا فَأَوْدِيَةُ الشُّرْبَبِ فَالشُّعْبَتَانِ فَالْأَبْلَاءُ"
    },
    {
      "i": 10,
      "text": "لَا أَرَى مَنْ عَهِدْتُ فِيهَا"
    },
    {
      "i": 11,
      "text": "فَأَبْكِي الْيَومَ دَلْهًا وَمَا يَرُدُّ الْبُكَاءُ"
    },
    {
      "i": 12,
      "text": "وَبِعَيْنَيْكَ أَوْقَدَتْ هِنْدٌ النَّارَ أَخِيراً تُلْوِي بِهَا الْعَلْيَاءُ"
    },
    {
      "i": 13,
      "text": "أَوْقَدَتْهَا بَيْنَ الْعَقِيقِ فَشَخْصَيْنِ بِعُودٍ كَمَا يَلُوحُ الضِّيَاءُ"
    },
    {
      "i": 14,
      "text": "فَتَنَوَّرْتُ نَارَهَا مِنْ بَعِيدٍ بِخَزَازٍ هَيْهَاتَ مِنْكَ الصَّلَاءُ"
    },
    {
      "i": 15,
      "text": "غَيْرَ أَنِّي قَدْ أَسْتَعِينُ عَلَى الْهَمِّ"
    },
    {
      "i": 16,
      "text": "إِذَا خَفَّ بِالثَّوِيِّ النَجَاءُو"
    },
    {
      "i": 17,
      "text": "بِزَفُوفٍ كَأَنَّهَا هِقْلَةٌ أُمُّ رِئَالٍ دَوِيَّةٌ سَقْفَاءُ"
    },
    {
      "i": 18,
      "text": "آنَسَتْ نَبأَةً وَأَفْزَعَهَا الْقَنَّاصُ عَصْرًا وَقَدْ دَنَا الْإِمْسَاءُ"
    },
    {
      "i": 19,
      "text": "فَتَرَى خَلْفَها مِنَ الرَّجْعِ وَالْوَقْعِ مَنِينًا كَأَنَّهُ إِهْبَاءُ"
    },
    {
      "i": 20,
      "text": "وَطِرَاقًا مِنْ خَلْفِهِنَّ طِرَاقٌ سَاقِطَاتٌ أَلْوَتْ بِهَا الصَّحْرَاءُ"
    },
    {
      "i": 21,
      "text": "أَتَلَهَّى بِهَا الْهَوَاجِرَ إِذْ كُلُّ ابْنُ هَمٍّ بَلِيَّةٌ عَمْيَاءُ"
    },
    {
      "i": 22,
      "text": "أَتَلَهَّى بِهَا الْهَوَاجِرَ إِذْ كُلُّ ابْنُ هَمٍّ بَلِيَّةٌ عَمْيَاءُ"
    }
  ],
